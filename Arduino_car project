#include <ESP32Servo.h>

// Servo pin
int servoPin = 13;
Servo myServo;

// Ultrasonic pins
int trigPin = 5;
int echoPin = 18;

// Motor driver pins
int motor1Pin1 = 27;  // IN1
int motor1Pin2 = 26;  // IN2
int motor2Pin1 = 25;  // IN3
int motor2Pin2 = 33;  // IN4

long duration;
int distance;

void setup() {
  Serial.begin(115200);

  // Motor pins setup
  pinMode(motor1Pin1, OUTPUT);
  pinMode(motor1Pin2, OUTPUT);
  pinMode(motor2Pin1, OUTPUT);
  pinMode(motor2Pin2, OUTPUT);

  // Ultrasonic setup
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Servo setup (ESP32 အတွက် pulse width သတ်မှတ်ပေးခြင်း)
  myServo.setPeriodHertz(50);    // Standard 50Hz servo
  myServo.attach(servoPin, 500, 2400); 
  myServo.write(90); // Facing forward
  delay(500);
}

// Function to measure distance cleanly
int getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // Timeout ကို 30,000 microseconds (30ms) သတ်မှတ်ထားသဖြင့် စင်ဆာ ကြောက်နေပါက အကြာကြီး တန့်မနေပါ
  duration = pulseIn(echoPin, HIGH, 30000); 
  
  if (duration == 0) {
    return 0; // စင်ဆာ ကြိုးလွတ်နေလျှင် သို့မဟုတ် မဖတ်မိလျှင် 0 ဟု သတ်မှတ်မည်
  }

  distance = duration * 0.034 / 2; // Convert to cm
  return distance;
}

// Motor control functions
void forward() {
  digitalWrite(motor1Pin1, HIGH);
  digitalWrite(motor1Pin2, LOW);
  digitalWrite(motor2Pin1, HIGH);
  digitalWrite(motor2Pin2, LOW);
}

void backward() {
  digitalWrite(motor1Pin1, LOW);
  digitalWrite(motor1Pin2, HIGH);
  digitalWrite(motor2Pin1, LOW);
  digitalWrite(motor2Pin2, HIGH);
}

void left() {
  digitalWrite(motor1Pin1, LOW);
  digitalWrite(motor1Pin2, HIGH);
  digitalWrite(motor2Pin1, HIGH);
  digitalWrite(motor2Pin2, LOW);
}

void right() {
  digitalWrite(motor1Pin1, HIGH);
  digitalWrite(motor1Pin2, LOW);
  digitalWrite(motor2Pin1, LOW);
  digitalWrite(motor2Pin2, HIGH);
}

void stopCar() {
  digitalWrite(motor1Pin1, LOW);
  digitalWrite(motor1Pin2, LOW);
  digitalWrite(motor2Pin1, LOW);
  digitalWrite(motor2Pin2, LOW);
}

void loop() {
  int dist = getDistance();
  Serial.print("Distance: ");
  Serial.print(dist);
  Serial.println(" cm");

  // စင်ဆာက 20cm ထက်ဝေးပြီး အမှားအယွင်း (0 သို့မဟုတ် 400cm ထက်ကျော်) မရှိပါက ရှေ့သို့သွားမည်
  if (dist > 20 && dist < 400) {
    forward(); 
  } 
  // စင်ဆာက အတားအဆီးတွေ့လျှင် (သို့မဟုတ်) စင်ဆာဖတ်၍မရပါက ရပ်ပြီး လမ်းကြောင်းရှာမည်
  else {
    stopCar();
    delay(300);

    // Check left
    myServo.write(150); // ဘယ်ဘက်ကြည့်မည်
    delay(500);
    int leftDist = getDistance();

    // Check right
    myServo.write(30);  // ညာဘက်ကြည့်မည်
    delay(500);
    int rightDist = getDistance();

    // Reset servo to front
    myServo.write(90);
    delay(400);

    // ဘယ်/ညာ အကွာအဝေးကို နှိုင်းယှဉ်၍ ပိုဝေးသောဘက်သို့ ကွေ့မည်
    if (leftDist == 0 && rightDist == 0) {
      // စင်ဆာနှစ်ဖက်စလုံး ဖတ်မရပါက နောက်နည်းနည်းဆုတ်မည်
      backward();
      delay(500);
      stopCar();
    } 
    else if (leftDist > rightDist) {
      left();
      delay(600); // ကွေ့သည့်အချိန် (လိုအပ်ပါက စက္ကန့် အတိုးအလျှော့လုပ်ပါ)
    } 
    else {
      right();
      delay(600);
    }
    
    stopCar();
    delay(200);
  }
  
  delay(50); // Loop တည်ငြိမ်စေရန်
}